{% extends 'layout/page_card_notlogged.html.twig' %}

{% block content_block %}
    <style>
      body.welcome-anonymous{background:#fbf8f6;color:#252331}
      .page-anonymous .container-tight{max-width:520px!important}
      .page-anonymous .main-content-card{border:1px solid #ece5e6;border-radius:20px;box-shadow:0 24px 65px #35233312;overflow:hidden}
      .page-anonymous .main-content-card .card-body{padding:32px 35px 38px}
      .page-anonymous .main-content-card .col-md-5{width:100%;max-width:100%}
      .page-anonymous .main-content-card .card-header{border:0;background:transparent;padding:0;display:block!important}
      .page-anonymous .main-content-card h2{font-size:29px;letter-spacing:-.05em;color:#252331;font-weight:750}
      .page-anonymous .form-control{border-radius:10px;padding:12px 14px;border-color:#dfd7dc}
      .page-anonymous .form-control:focus{border-color:#e75582;box-shadow:0 0 0 3px #e7558222}
      .page-anonymous .btn-primary{background:#e75582;border-color:#e75582;border-radius:10px;padding:12px}
      .page-anonymous .btn-primary:hover{background:#bd365f;border-color:#bd365f}
      .pd57-login-intro{color:#77737e;margin:-11px 0 28px;text-align:center;font-size:14px}
      .pd57-login-eyebrow{color:#bd365f;font-size:11px;text-align:center;letter-spacing:.17em;font-weight:800;margin-bottom:7px}
      .page-anonymous .forgot_password a,.page-anonymous .main-content-card a{color:#bd365f}
    </style>
    <form action="{{ path('front/login.php') }}" method="post" autocomplete="off" data-submit-once>
        <input type="hidden" name="noAUTO" value="{{ noAuto }}"/>
        <input type="hidden" name="redirect" value="{{ redirect }}"/>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"/>
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card-header mb-4">
                    <p class="pd57-login-eyebrow">YOUR WORKSPACE</p>
                    <h2 class="mx-auto text-center">Welcome to Physical Desk</h2>
                </div>
                <p class="pd57-login-intro">Sign in to request help and stay on top of every update.</p>
                <div class="mb-3">
                    <label class="form-label" for="login_name">Work email or username</label>
                    <input type="text" class="form-control" id="login_name" name="login_name" placeholder=""/>
                </div>
                <div class="mb-4">
                    <div class="d-flex">
                        <label class="form-label" for="login_password">
                            {{ __('Password') }}
                        </label>
                    </div>
                    <input type="password" class="form-control" id="login_password" name="login_password" placeholder="" autocomplete="off"/>
                </div>


                {% if config('login_remember_time') %}
                    <div class="mb-2">
                        <label class="form-check" for="login_remember">
                            <input type="checkbox" class="form-check-input" id="login_remember" name="login_remember" {{ config('login_remember_default') ? 'checked' : '' }}/>
                            <span class="form-check-label">{{ __('Remember me') }}</span>
                        </label>
                    </div>
                {% endif %}

                <div class="form-footer">
                    <button type="submit" name="submit" class="btn btn-primary w-100 mb-2">
                        {{ __('Sign in') }}
                    </button>
                    {% if show_lost_password %}
                        <div class="ms-auto text-center forgot_password">
                            <a href="{{ path('front/lostpassword.php?lostpassword=1') }}">
                                {{ __('Forgotten password?') }}
                            </a>
                        </div>
                        {% if config('display_login_source') %}
                            <script>
                                $(() => {
                                    if ($('select[name="auth"]').val() === 'local') {
                                        $('.forgot_password').removeClass('d-none');
                                    }
                                    $('select[name="auth"]').on('change', function () {
                                        if ($(this).val() === 'local') {
                                            $('.forgot_password').removeClass('d-none');
                                        } else {
                                            $('.forgot_password').addClass('d-none');
                                        }
                                    });
                                });
                            </script>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

            {% if right_panel %}
                <div class="col-auto px-2 text-center">
                    {{ call_plugin_hook(constant('Glpi\\Plugin\\Hooks::DISPLAY_LOGIN')) }}
                </div>
            {% endif %}
        </div>
        {% if config('use_public_faq') %}
            <div class="text-center mt-4 border-top">
                <a class="btn btn-outline-secondary mt-4" href="{{ path('front/helpdesk.faq.php') }}">
                    <i class="ti ti-help"></i>&nbsp;
                    {{ __('FAQ') }}
                </a>
            </div>
        {% endif %}
    </form>
{% endblock %}

{% block footer_block %}
    <span>Physical Desk · <a href="{{ path('/front/about.php') }}">Open source notices</a></span>

    {% if must_call_cron %}
        <div style="background-image: url('{{ path('/front/cron.php') }}');"></div>
    {% endif %}
{% endblock %}

{% block javascript_block %}
    <script type="text/javascript">
        $(function () {
            $('#login_name').focus();
        });
    </script>
{% endblock %}
